# ==============================================
# BE & FE
# ==============================================
# PostgreSQL Database Connection Details
DB_HOST=<db-host>
DB_PORT=5432
POSTGRES_USER=<db-user>
POSTGRES_PASSWORD=<db-password>
POSTGRES_DB=<db-name>
DATABASE_URL=postgres://<db-user>:<db-password>@<db-host>:<db-port>/<db-name>

# JWT Secret for creating authentication tokens
JWT_SECRET=<jwt-secret>
LMS_URL=http://<lms-host>/api/LMS-dev/v1/decode

# Server Port
BACKEND_PORT=<backend-port>
FRONTEND_PORT=<frontend-port>

NODE_ENV=production

VITE_API_URL=http://<backend-host>:<backend-port>/api

# User API Endpoint
USER_API_ENDPOINT=http://<global-api-host>/api/global/v1/custom/list-user-magang

EXTERNAL_APPROVAL_URL=http://<global-api-host>/api/global/v1/custom/list-approval-magang

# SMTP Email Configuration
SMTP_HOST=<smtp-host>
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
# ==============================================
# Email Notification
# EMAIL_TEST_MODE: true = semua email hanya ke EMAIL_TEST_TO (DEV), false = ke penerima asli (LIVE)
EMAIL_TEST_MODE=false
EMAIL_TEST_TO=<email-tester>
LMS_LOGIN_URL=http://<lms-host>/lms/login
